# Copy this file to backend/.env (never commit .env to Git).
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# Dedicated Fernet key for encrypting OAuth tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Optional application session signing key (auto-generated ephemerally in local dev if omitted)
APP_SECRET_KEY=

DATABASE_URL=sqlite:///./lifedesk.db
FRONTEND_URL=http://localhost:5173
MAX_TOOL_ITERATIONS=8
USER_TIMEZONE=UTC
ALLOW_DEMO_USER_FALLBACK=true
DEMO_MODE=false
